<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recrutement - NewStreet Roleplay</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Poppins', sans-serif; }
        body {
            background-color: #070913;
            color: #ffffff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            overflow-x: hidden;
            position: relative;
        }

        /* Même bannière en fond que l'accueil */
        .bg-banner {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: url('https://media.discordapp.net/attachments/1531037885145550918/1531044082040705174/image.png?ex=6a67c76a&is=6a6675ea&hm=3b1ce7eaef124e053bdf9ede7ac4079a1a691f923267191976f2f13a7fb9f596&=&format=webp&quality=lossless');
            background-size: cover;
            background-position: center;
            opacity: 0.25;
            z-index: 1;
        }

        body::after {
            content: '';
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: radial-gradient(circle at center, rgba(11, 15, 25, 0.6) 0%, rgba(7, 9, 19, 0.95) 100%);
            z-index: 2;
            pointer-events: none;
        }

        /* Barre de navigation supérieure */
        nav {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 25px 50px;
            z-index: 50;
        }

        .nav-brand {
            display: flex;
            align-items: center;
            gap: 15px;
            text-decoration: none;
            color: white;
        }

        .nav-logo {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #8b5cf6;
            box-shadow: 0 0 15px rgba(139, 92, 246, 0.5);
        }

        .nav-title {
            font-size: 18px;
            font-weight: 700;
            letter-spacing: 0.5px;
            background: linear-gradient(135deg, #ffffff, #a78bfa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .nav-links {
            display: flex;
            gap: 30px;
        }

        .nav-links a {
            color: #9ca3af;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            transition: color 0.3s ease;
        }

        .nav-links a:hover, .nav-links a.active {
            color: #ffffff;
            text-shadow: 0 0 10px rgba(139, 92, 246, 0.6);
        }

        /* Contenu Principal */
        .main-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 100px 20px 40px 20px;
            position: relative;
            z-index: 10;
        }

        .recruitment-container {
            background: rgba(17, 24, 39, 0.8);
            border: 1px solid rgba(139, 92, 246, 0.35);
            backdrop-filter: blur(16px);
            padding: 40px;
            border-radius: 24px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7), 0 0 40px rgba(139, 92, 246, 0.15);
            max-width: 900px;
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 25px;
        }

        .recruitment-header {
            display: flex;
            align-items: flex-start;
            gap: 15px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            padding-bottom: 20px;
        }

        .header-icon {
            background: rgba(139, 92, 246, 0.2);
            border: 1px solid rgba(139, 92, 246, 0.4);
            color: #a78bfa;
            padding: 12px;
            border-radius: 14px;
            font-size: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .header-text h2 {
            font-size: 22px;
            font-weight: 700;
            color: white;
            margin-bottom: 5px;
        }

        .header-text p {
            color: #9ca3af;
            font-size: 14px;
            line-height: 1.5;
        }

        /* Grille des 5 postes */
        .jobs-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 20px;
        }

        .job-card {
            background: rgba(11, 15, 25, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 16px;
            padding: 24px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: all 0.3s ease;
        }

        .job-card:hover {
            border-color: rgba(139, 92, 246, 0.4);
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
        }

        .job-info h3 {
            font-size: 17px;
            font-weight: 600;
            color: white;
            margin-bottom: 8px;
        }

        .job-info p {
            color: #9ca3af;
            font-size: 13px;
            line-height: 1.5;
            margin-bottom: 20px;
        }

        .btn-apply {
            display: block;
            width: 100%;
            padding: 10px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            text-align: center;
            text-decoration: none;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        /* État Ouvert / Fermé */
        .btn-open {
            background: rgba(16, 185, 129, 0.15);
            color: #34d399;
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

        .btn-open:hover {
            background: rgba(16, 185, 129, 0.3);
            box-shadow: 0 0 15px rgba(16, 185, 129, 0.3);
        }

        .btn-closed {
            background: rgba(239, 68, 68, 0.15);
            color: #f87171;
            border: 1px solid rgba(239, 68, 68, 0.3);
            cursor: not-allowed;
        }

        /* Widget de musique flottant */
        .music-widget {
            position: fixed;
            bottom: 25px;
            right: 25px;
            z-index: 100;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
        }

        .music-btn {
            background: rgba(17, 24, 39, 0.9);
            border: 1px solid rgba(139, 92, 246, 0.4);
            color: white;
            padding: 12px 20px;
            border-radius: 30px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
            backdrop-filter: blur(12px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.6);
            transition: all 0.3s ease;
        }

        .music-btn:hover {
            background: rgba(139, 92, 246, 0.25);
            transform: scale(1.05);
        }

        .music-player-box {
            display: none;
            margin-bottom: 12px;
            background: rgba(17, 24, 39, 0.95);
            border: 1px solid rgba(139, 92, 246, 0.3);
            padding: 12px;
            border-radius: 16px;
            backdrop-filter: blur(16px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.7);
            width: 300px;
        }

        .music-player-box.active {
            display: block;
            animation: fadeIn 0.3s ease-in-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        footer {
            padding: 20px;
            text-align: center;
            color: #6b7280;
            font-size: 13px;
            border-top: 1px solid rgba(255, 255, 255, 0.03);
            position: relative;
            z-index: 10;
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .footer-dev {
            color: #a78bfa;
            font-weight: 500;
            letter-spacing: 0.5px;
        }
    </style>
</head>
<body>

    <div class="bg-banner"></div>

    <!-- Barre de Navigation avec Logo à gauche -->
    <nav>
        <a href="/" class="nav-brand">
            <img src="https://media.discordapp.net/attachments/1531037885145550918/1531044081747230830/Logo_Fivem_N.png?ex=6a67c76a&is=6a6675ea&hm=692140dcde62bd6e8dad05a69b7a8bb750a15266e7aa4d00749a3830e6ac4ada&=&format=webp&quality=lossless&width=1216&height=1216" alt="Logo" class="nav-logo">
            <span class="nav-title">NewStreet RP</span>
        </a>
        <div class="nav-links">
            <a href="/">Accueil</a>
            <a href="/recrutement" class="active">Recrutement</a>
        </div>
    </nav>

    <!-- Conteneur central des 5 postes -->
    <div class="main-wrapper">
        <div class="recruitment-container">
            <div class="recruitment-header">
                <div class="header-icon">🛡️</div>
                <div class="header-text">
                    <h2>Rejoindre l'équipe de NewStreet Roleplay</h2>
                    <p>Nous recherchons des personnes motivées pour maintenir la qualité du Roleplay et faire rayonner le serveur. Postule dès maintenant ci-dessous !</p>
                </div>
            </div>

            <div class="jobs-grid">
                <!-- 1. Gérant Légal -->
                <div class="job-card">
                    <div class="job-info">
                        <h3>Gérant Légal</h3>
                        <p>Superviser et gérer les entreprises et factions légales du serveur (LSPD, EMS, etc.).</p>
                    </div>
                    <a href="#" class="btn-apply btn-open">Recrutement ouvert — postuler</a>
                </div>

                <!-- 2. Gérant Illégal -->
                <div class="job-card">
                    <div class="job-info">
                        <h3>Gérant Illégal</h3>
                        <p>Encadrer les organisations criminelles, gérer les territoires et veiller à l'équilibrage de l'illégal.</p>
                    </div>
                    <a href="#" class="btn-apply btn-open">Recrutement ouvert — postuler</a>
                </div>

                <!-- 3. Community Manager -->
                <div class="job-card">
                    <div class="job-info">
                        <h3>Community Manager</h3>
                        <p>Animer les réseaux sociaux (TikTok/YouTube/Twitter) et dynamiser la communauté.</p>
                    </div>
                    <a href="#" class="btn-apply btn-closed">Recrutement fermé</a>
                </div>

                <!-- 4. Modération -->
                <div class="job-card">
                    <div class="job-info">
                        <h3>Modération</h3>
                        <p>Veiller au bon déroulement du serveur en jeu et sur Discord, gérer les tickets.</p>
                    </div>
                    <a href="#" class="btn-apply btn-open">Recrutement ouvert — postuler</a>
                </div>

                <!-- 5. Développeur -->
                <div class="job-card">
                    <div class="job-info">
                        <h3>Développeur</h3>
                        <p>Créer, optimiser et configurer les scripts pour améliorer l'expérience de jeu globale.</p>
                    </div>
                    <a href="#" class="btn-apply btn-open">Recrutement ouvert — postuler</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Lecteur de musique discret -->
    <div class="music-widget">
        <div class="music-player-box" id="playerBox">
            <iframe style="border-radius:12px" src="https://open.spotify.com/embed/track/5kfAx6phDHPpz5g8IAPyc2?utm_source=generator&theme=0" width="100%" height="80" frameBorder="0" allowfullscreen="" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
        </div>
        <button class="music-btn" onclick="togglePlayer()">
            🎧 <span>Ambiance Sonore</span>
        </button>
    </div>

    <footer>
        <div>&copy; 2026 NewStreet Roleplay. Tous droits réservés.</div>
        <div class="footer-dev">Server made by : L2B & R2</div>
    </footer>

    <script>
        function togglePlayer() {
            const box = document.getElementById('playerBox');
            box.classList.toggle('active');
        }
    </script>

</body>
</html>
