<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Urgence Lilloise - Recrutement</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <h1>Candidature - Urgence Lilloise</h1>
        
        <form action="/submit-application" method="POST">
            <div class="form-group">
                <label for="service">Poste souhaité :</label>
                <select id="service" name="service" required>
                    <option value="">-- Choisissez un poste --</option>
                    <option value="Gérant Illégal">Gérant Illégal</option>
                    <option value="Gérant Légal">Gérant Légal</option>
                    <option value="Modération">Modération</option>
                    <option value="Développeur">Développeur</option>
                    <option value="Community Manager">Community Manager</option>
                </select>
            </div>

            <div class="form-group">
                <label for="discordTag">Pseudo Discord (ex: pseudo#0000 ou pseudo) :</label>
                <input type="text" id="discordTag" name="discordTag" required>
            </div>

            <div class="form-group">
                <label for="discordId">ID Discord (optionnel) :</label>
                <input type="text" id="discordId" name="discordId">
            </div>

            <div class="form-group">
                <label for="prenom">Prénom :</label>
                <input type="text" id="prenom" name="prenom" required>
            </div>

            <div class="form-group">
                <label for="age">Âge :</label>
                <input type="number" id="age" name="age">
            </div>

            <div class="form-group">
                <label for="ambition">Vos ambitions :</label>
                <textarea id="ambition" name="ambition" rows="3"></textarea>
            </div>

            <div class="form-group">
                <label for="motivation">Vos motivations :</label>
                <textarea id="motivation" name="motivation" rows="4" required></textarea>
            </div>

            <div class="form-group">
                <label for="experience">Expériences passées :</label>
                <textarea id="experience" name="experience" rows="3"></textarea>
            </div>

            <div class="form-group">
                <label for="roleModerateur">Vision du rôle :</label>
                <textarea id="roleModerateur" name="roleModerateur" rows="3"></textarea>
            </div>

            <button type="submit" class="btn-submit">Envoyer ma candidature</button>
        </form>
    </div>
</body>
</html>
