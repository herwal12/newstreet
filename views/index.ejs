<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NewStreet Roleplay</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Poppins', sans-serif; }
        body {
            background-color: #070913;
            color: #ffffff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            overflow-x: hidden;
            position: relative;
        }

        /* Intégration subtile et artistique de ton image en fond global */
        .bg-banner {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: url('https://media.discordapp.net/attachments/1531037885145550918/1531044082040705174/image.png?ex=6a67c76a&is=6a6675ea&hm=3b1ce7eaef124e053bdf9ede7ac4079a1a691f923267191976f2f13a7fb9f596&=&format=webp&quality=lossless');
            background-size: cover;
            background-position: center;
            opacity: 0.25; /* Transparence pour que ça reste très lisible */
            z-index: 1;
        }

        /* Voile sombre par-dessus pour garder l'ambiance sombre et pro */
        body::after {
            content: '';
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: radial-gradient(circle at center, rgba(11, 15, 25, 0.6) 0%, rgba(7, 9, 19, 0.95) 100%);
            z-index: 2;
            pointer-events: none;
        }

        .main-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
            text-align: center;
            position: relative;
            z-index: 10;
        }

        .hero-card {
            background: rgba(17, 24, 39, 0.75);
            border: 1px solid rgba(139, 92, 246, 0.35);
            backdrop-filter: blur(16px);
            padding: 50px 40px;
            border-radius: 24px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7), 0 0 40px rgba(139, 92, 246, 0.2);
            max-width: 650px;
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
        }

        .hero-card::before {
            content: '';
            position: absolute;
            top: 40px;
            width: 130px;
            height: 130px;
            background: rgba(139, 92, 246, 0.4);
            filter: blur(40px);
            border-radius: 50%;
            z-index: 1;
        }

        .server-logo {
            position: relative;
            z-index: 2;
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid #8b5cf6;
            box-shadow: 0 0 25px rgba(139, 92, 246, 0.6);
            margin-bottom: 25px;
            animation: floatLogo 3s infinite ease-in-out;
            background: #111827;
        }

        @keyframes floatLogo {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-6px); }
        }

        h1 {
            font-size: 38px;
            font-weight: 700;
            letter-spacing: 1px;
            margin-bottom: 15px;
            background: linear-gradient(135deg, #ffffff, #a78bfa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            position: relative;
            z-index: 3;
        }

        p {
            color: #9ca3af;
            font-size: 16px;
            line-height: 1.6;
            margin-bottom: 35px;
            position: relative;
            z-index: 3;
        }

        .buttons-group {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            justify-content: center;
            width: 100%;
            position: relative;
            z-index: 3;
        }

        .btn {
            padding: 14px 28px;
            border-radius: 12px;
            font-size: 15px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }

        .btn-primary {
            background: linear-gradient(135deg, #8b5cf6, #6d28d9);
            color: white;
            border: none;
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(139, 92, 246, 0.4);
        }

        .btn-secondary {
            background: rgba(255, 255, 255, 0.05);
            color: white;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.1);
            transform: translateY(-3px);
        }

        footer {
            padding: 20px;
            text-align: center;
            color: #6b7280;
            font-size: 13px;
            border-top: 1px solid rgba(255, 255, 255, 0.03);
            position: relative;
            z-index: 10;
        }
    </style>
</head>
<body>

    <!-- Ton image intégrée proprement en arrière-plan -->
    <div class="bg-banner"></div>

    <div class="main-wrapper">
        <div class="hero-card">
            <!-- Ton Logo -->
            <img src="https://media.discordapp.net/attachments/1531037885145550918/1531044081747230830/Logo_Fivem_N.png?ex=6a67c76a&is=6a6675ea&hm=692140dcde62bd6e8dad05a69b7a8bb750a15266e7aa4d00749a3830e6ac4ada&=&format=webp&quality=lossless&width=1216&height=1216" alt="NewStreet Logo" class="server-logo">
            
            <!-- Titre -->
            <h1>NewStreet Roleplay</h1>
            
            <!-- Description -->
            <p>Plonge dans une expérience de jeu unique. Rejoins our communauté, découvre nos nouveautés et lance ton aventure dès maintenant.</p>
            
            <!-- Boutons -->
            <div class="buttons-group">
                <a href="/recrutement" class="btn btn-primary">Accéder aux recrutements</a>
                <a href="https://discord.gg/HjA3X9pPrU" target="_blank" class="btn btn-secondary">Rejoindre le Discord</a>
            </div>
        </div>
    </div>

    <footer>
        &copy; 2026 NewStreet Roleplay. Tous droits réservés.
    </footer>

</body>
</html>
